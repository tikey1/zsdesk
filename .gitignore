# Build output
/target/
*.json.tmp

# Per-user state is never part of source or release payloads.
/data/
/portable.flag
/desktop-fences*.json
/explorer-session*.json
/shell-routing*.json
/takeover-backup*.json
/search-index.sqlite*
/quick-search*.json
/clients.ini
/package.ini

# Release binaries are produced by scripts/package.ps1; notes and manifests stay tracked.
/releases/**/*.exe
/releases/**/*.dll
/releases/**/*.zip
/releases/**/*.lnk

# WorkBuddy 的本地项目数据（记忆 / 快照 / 索引）—— 不属于源码
/.workbuddy/
