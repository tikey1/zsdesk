<!--
    UI design v2: collapsible preview pane, see docs/07-UI-DESIGN-WINUI3.md.

    D-15: static preview pane layout only. No event attributes, no scripts with
    business logic. Rust owns channel selection, decoding and buffer release.
    GuoheView.exe is NOT used here; the priority channel is the in-DLL
    ui_gh_img_view_* family (architecture 6.3), with bitmap and text fallbacks.

    ---------------------------------------------------------------------------
    2026-11-13  core-ui 标签修正
    依据：docs/11-COREUI-MARKUP-TAGS.md
    权威源：上游 core-ui src/ui/page/widget_factory.cpp → ConstructByTag
    ---------------------------------------------------------------------------
    一、标签替换（设计意图 / 尺寸 / 间距 / 配色一律不动）
        <hbox>       ×1 → <div>，.preview-toolbar 补 flex-direction: row
        <vbox>       ×1 → <div>
        <panel>      ×1 → <div>
        <text>       ×5 → <span>×1（工具条标题，短、单行）
                          <label>×4（提示 / 通道 / 大小 / 状态，需占满宽度可换行）
        <separator>  ×1 → <div class="divider">（见下 §2.6）
      模板体元素数不变（9 → 9；连 <window>/<style>/<template> 三个 SFC
      外壳一起算是 12 → 12）。
      说明：core-ui 的 span / label 落到同一分支（LabelWidget，wrap=true，
      display=inline），行为一致；「占满宽度 / 可换行」由 CSS display: block
      决定，本文件据此逐个设置。

    二、结构级修正
      1. <window> 必须自闭合，<style>/<template> 提到顶层
         （上游 sfc_parser.cpp：非自闭合 → SFC parse failed，整页不加载）。
      2. 文本写在元素内部；text="..." 属性在 .uix 只对 <menu> 生效。
      3. window { ... } 选择器不匹配任何控件 → 落到根节点 class="root"。
      4. core-ui 无 CSS 属性继承 → 每个有文字的 class 各自声明 color。
      5. .preview-toolbar 补 align-items: center（32px 条内标题垂直居中）。
      6. <separator> → <div class="divider">：SeparatorWidget::OnDraw
         （上游 controls.cpp:635-643）不调用 Widget::OnDraw，CSS background
         永远不会被画出来，线条颜色写死 theme::kDivider()（light #D1D1D1 /
         dark #424242）。要让分隔线走项目 token --app-divider 必须用 div。
         上游 demo 同款做法：<div class="sep"/> + height:1 + background。

    三、主题 token：全部改用 --app-* 前缀，避开 core-ui 自有的 34 个库 token，
      详见 docs/12-UIX-TAG-FIX.md 与 assets/themes.json。
-->
<window title="预览" width="320" height="600" />
<style>
  /* 根容器：原 window { ... } 规则（<window> 是 SFC 外壳，选择器不匹配控件）。
     font-family 只是设计记录 —— core-ui 只在 SVG 文本路径读该属性，普通
     LabelWidget 一律走 ui_theme_set_default_font 设的字体（见 docs/12 §1）。 */
  .root { background: var(--app-sidebar-bg); color: var(--app-text); font-family: "Segoe UI Variable", "Segoe UI"; }

  /* 预览工具条 32px */
  .preview-toolbar { height: 32px; background: var(--app-toolbar-bg); flex-direction: row; align-items: center; }
  .preview-title { padding: 8px; font-weight: 600; color: var(--app-text); white-space: nowrap; }

  /* 预览正文区 */
  .preview-body { flex: 1; padding: 8px; }

  /* 预览提示行 / 通道状态行：占满宽度、可换行（Rust 侧写入的通道名可能较长） */
  .preview-hint { display: block; padding: 8px; color: var(--app-text-secondary); }
  /* ⚠️ .preview-collapsed 当前是死规则（无元素引用）：core-ui 没有运行时设置
     class 的 C API，Rust 切不到这个类 —— 折叠态只能靠 Rust 直接改宽度
     （见 docs/12 §5 R10）。 */
  .preview-collapsed { width: 0px; }
  .preview-state { display: block; padding: 8px; color: var(--app-info-fg); }

  /* 水平分隔线 1px：必须用 <div> 而不是 <separator> ——
     SeparatorWidget::OnDraw（controls.cpp:635-643）不调用 Widget::OnDraw，
     CSS background 永远不会被画出来，线条颜色写死 theme::kDivider()。
     上游 demo 同款做法：<div class="sep"/> + height:1 + background。 */
  .divider { height: 1px; background: var(--app-divider); flex-shrink: 0; }
</style>
<template>
  <div class="root">
    <div class="preview-toolbar">
      <span id="preview_title" class="preview-title">预览</span>
    </div>
    <div class="divider" />
    <div id="preview_body" class="preview-body" />
    <label id="preview_hint" class="preview-hint">选中单个文件以预览</label>
    <label id="preview_channel" class="preview-hint" />
    <label id="preview_size" class="preview-hint" />
    <label id="preview_state" class="preview-state" />
  </div>
</template>
